# Supabase (โปรเจกต์ฟรีได้)
# สร้างโปรเจกต์ที่ https://supabase.com แล้วรัน supabase/setup.sql ใน SQL Editor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# เชื่อม Postgres ของ Supabase โดยตรงเมื่อยังไม่มี API keys
DATABASE_URL=

# ตัวตั้งเวลาฟรียิง /api/cron/send ด้วยหัวข้อนี้
# เครื่องพัฒนาที่ไม่ได้ตั้งค่า จะใช้ dev-cron-secret
CRON_SECRET=

# LINE Messaging API — เว้นว่างได้ แอปยังเปิดตัวอย่างข้อความและปุ่มคะแนนได้
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# รหัสผู้ใช้ (U...) กลุ่ม (C...) ห้อง (R...) หรือคำว่า broadcast
LINE_TARGET_ID=

# ไม่บังคับ ใช้เมื่ออยากให้อ่านภาพปฏิทินอัตโนมัติ
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# URL สาธารณะของแอป ใช้ตอนบอก webhook และ GitHub Action
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
