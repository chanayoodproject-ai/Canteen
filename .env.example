# Supabase (โปรเจกต์ฟรีได้)
# สร้างโปรเจกต์ที่ https://supabase.com แล้วรัน supabase/setup.sql ใน SQL Editor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# เชื่อม Postgres ของ Supabase โดยตรงเมื่อยังไม่มี API keys
DATABASE_URL=

# ตัวตั้งเวลาฟรียิง /api/cron/send ด้วยหัวข้อนี้
# เครื่องพัฒนาที่ไม่ได้ตั้งค่า จะใช้ dev-cron-secret
CRON_SECRET=

# LINE Messaging API — เว้นว่างได้ แอปยังเปิดตัวอย่างข้อความและปุ่มคะแนนได้
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# รหัสผู้ใช้ (U...) กลุ่ม (C...) ห้อง (R...) หรือคำว่า broadcast
LINE_TARGET_ID=

# อ่านภาพปฏิทินอัตโนมัติผ่าน Vercel AI Gateway
# บน Vercel ใช้ OIDC อัตโนมัติ ไม่ต้องมีคีย์ ส่วนเครื่องพัฒนาใส่ AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=
# เปลี่ยนโมเดลได้โดยไม่ต้องแก้โค้ด (ค่าเริ่มต้น google/gemini-3-flash)
AI_VISION_MODEL=
# ทางหลัก (ไม่ต้องผูกบัตร): คีย์ฟรีจาก https://aistudio.google.com/apikey
# ใส่ที่นี่ หรือเก็บในตาราง public.app_secrets (key = GOOGLE_GENERATIVE_AI_API_KEY) ก็ได้
GOOGLE_GENERATIVE_AI_API_KEY=
# ไม่บังคับ: โมเดลที่ลองก่อน (ค่าเริ่มต้น gemini-3-flash-preview แล้วสำรองรุ่นอื่นอัตโนมัติ)
GEMINI_MODEL=
# ไม่บังคับ: ระดับการคิดของโมเดล (ค่าเริ่มต้น minimal เร็วและพอสำหรับคัดลอกตาราง)
GEMINI_THINKING=
# ทางสำรอง ถ้ามีคีย์ OpenAI โดยตรง
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# URL สาธารณะของแอป ใช้ตอนบอก webhook และ GitHub Action
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
